{
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "test": "playwright test",
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "lint": "npm run lint:js && npm run lint:styles",
    "lint:fix": "npm run lint:js:fix && npm run lint:styles:fix && npm run format",
    "lint:js": "eslint . --max-warnings=0",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:styles": "stylelint \"**/*.{css,scss}\" --max-warnings=0",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-solid": "0.19.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "sass": "1.108.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-solid": "2.11.15"
  }
}
